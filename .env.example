# AirLink Environment Configuration Example

# Network binding
AIRLINK_HOST=0.0.0.0
AIRLINK_PORT=8000

# Maximum upload size in bytes (default: 2147483648 = 2 GB)
AIRLINK_MAX_UPLOAD_SIZE=2147483648

# Security parameters
# Pairing code validity in seconds (default: 300 = 5 minutes)
AIRLINK_PAIRING_EXPIRY=300

# Client session validity in seconds (default: 43200 = 12 hours)
AIRLINK_SESSION_EXPIRY=43200

# Server secret key (leave blank to auto-generate a random key on startup)
# AIRLINK_SECRET_KEY=your_custom_secret_key_hex
